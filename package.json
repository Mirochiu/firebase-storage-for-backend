{
  "name": "@mirochiu/firebase-storage-for-backend",
  "version": "0.3.18",
  "description": "a simple wrapper for firebase storage via firebase-admin",
  "module": "./src/index.mjs",
  "main": "./src/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    "import": "./src/index.mjs",
    "require": "./src/index.cjs",
    "types": "./src/index.d.ts"
  },
  "keywords": [
    "firebase-storage",
    "firebase-admin",
    "firebase",
    "javascript"
  ],
  "author": "Mirochiu (https://mirochiu.page)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test-mjs": "env-cmd -f .env node samples/example.mjs",
    "test-cjs": "env-cmd -f .env node samples/example.cjs"
  },
  "dependencies": {
    "@google-cloud/storage": "7.21.0",
    "firebase-admin": "14.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mirochiu/firebase-storage-for-backend.git"
  },
  "devDependencies": {
    "env-cmd": "^11.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "protobufjs": "^7.6.5"
  },
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.6": true
  }
}
